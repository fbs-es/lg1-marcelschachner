  "components" : {
    "schemas" : {
      "Adresse" : {
        "type" : "object",
        "properties" : {
          "anschrift" : {
            "$ref" : "#/components/schemas/Anschrift"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "istLieferadresse" : {
            "type" : "boolean"
          },
          "istRechnungsadresse" : {
            "type" : "boolean"
          }
        },
        "required" : [ "anschrift", "id", "istLieferadresse", "istRechnungsadresse" ]
      },
      "AdresseEingabe" : {
        "type" : "object",
        "description" : "Adresse mit Kennzeichen; mindestens eines muss gesetzt sein (I-2)",
        "properties" : {
          "anschrift" : {
            "$ref" : "#/components/schemas/Anschrift"
          },
          "istLieferadresse" : {
            "type" : "boolean"
          },
          "istRechnungsadresse" : {
            "type" : "boolean"
          }
        },
        "required" : [ "anschrift", "istLieferadresse", "istRechnungsadresse" ]
      },
      "Anschrift" : {
        "type" : "object",
        "properties" : {
          "land" : {
            "type" : "string",
            "description" : "ISO-3166-Alpha-2-Code",
            "example" : "DE",
            "minLength" : 1
          },
          "postleitzahl" : {
            "type" : "string",
            "example" : "10115",
            "maxLength" : 20,
            "minLength" : 0
          },
          "stadt" : {
            "type" : "string",
            "example" : "Berlin",
            "maxLength" : 100,
            "minLength" : 0
          },
          "strasse" : {
            "type" : "string",
            "example" : "Hauptstraße 1",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "land", "postleitzahl", "stadt", "strasse" ]
      },
      "Bestellposition" : {
        "type" : "object",
        "properties" : {
          "einzelpreis" : {
            "$ref" : "#/components/schemas/Geld",
            "description" : "Listenpreis zum Checkout, eingefroren (D-10)"
          },
          "menge" : {
            "type" : "integer",
            "format" : "int32"
          },
          "produktId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "titel" : {
            "type" : "string"
          },
          "zeilennummer" : {
            "type" : "integer",
            "format" : "int32"
          },
          "zwischenbetrag" : {
            "$ref" : "#/components/schemas/Geld",
            "description" : "menge × einzelpreis"
          }
        },
        "required" : [ "einzelpreis", "menge", "produktId", "titel", "zeilennummer", "zwischenbetrag" ]
      },
      "Bestellung" : {
        "type" : "object",
        "properties" : {
          "bestelldatum" : {
            "type" : "string",
            "format" : "date"
          },
          "bestellnummer" : {
            "type" : "string",
            "example" : "B-2026-000123"
          },
          "faelligAm" : {
            "type" : "string",
            "format" : "date",
            "description" : "bestelldatum + Zahlungsziel (D-03)"
          },
          "gesamtwert" : {
            "$ref" : "#/components/schemas/Geld",
            "description" : "max(0, warenwert − rabattBetrag), berechnet (D-01)"
          },
          "gutscheincode" : {
            "type" : "string",
            "description" : "Eingelöster Gutschein, leer ohne Gutschein"
          },
          "kundenId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "lieferanschrift" : {
            "$ref" : "#/components/schemas/Anschrift",
            "description" : "Snapshot zum Checkout (D-08)"
